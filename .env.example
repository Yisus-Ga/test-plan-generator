# =============================================================================
# CONFIGURACIÓN DE ENTORNO - Test Plan Generator
# =============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a .env
# 2. Completa los valores, especialmente OPENAI_API_KEY
# 3. NUNCA subas tu archivo .env a GitHub (ya está en .gitignore)
# =============================================================================

# --- API Key de OpenAI (OBLIGATORIO para generar Test Plans) ---
# Obtén tu clave en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-tu-api-key-aqui

# --- Modelos de IA (opcionales, tienen valores por defecto) ---
# OPENAI_MODEL_TRANSLATION=gpt-4.1-mini
# OPENAI_MODEL_GENERATION=gpt-4.1

# --- Base de datos (opcional para desarrollo local) ---
# DATABASE_URL=sqlite:///./test_plan_generator.db

# --- Seguridad (cambiar en producción) ---
# SECRET_KEY=local-secret-key-change-in-production

# --- Desarrollo ---
# DEBUG=True
# LOG_LEVEL=INFO
